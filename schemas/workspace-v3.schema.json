{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalforge.local/schemas/workspace-v3.schema.json",
  "title": "EvalForge workspace v3",
  "type": "object",
  "required": ["schemaVersion", "workspace", "rubrics", "datasets", "cases", "sessions", "assignments", "reviews", "auditEvents"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "workspace": { "$ref": "#/$defs/workspace" },
    "rubrics": { "type": "array", "items": { "$ref": "#/$defs/rubric" } },
    "datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
    "auditEvents": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "anchors": {
      "type": "object",
      "required": ["1", "3", "5"],
      "properties": { "1": { "type": "string", "minLength": 1 }, "3": { "type": "string", "minLength": 1 }, "5": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["id", "label", "description", "weight", "anchors"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "weight": { "type": "number", "exclusiveMinimum": 0 }, "anchors": { "$ref": "#/$defs/anchors" } },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "createdAt", "updatedAt", "rubricIds", "datasetIds", "settings"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "createdAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" }, "rubricIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "datasetIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "settings": { "type": "object" } },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "description", "version", "tieThreshold", "dimensions", "checksum", "lockedAt"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "version": { "type": "string", "minLength": 1 }, "tieThreshold": { "type": "number", "minimum": 0 }, "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } }, "checksum": { "type": "string", "minLength": 1 }, "lockedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] } },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["schemaVersion", "id", "content", "source", "metadata"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "content": { "type": "string", "minLength": 1 }, "source": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "metadata": { "type": "object" } },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["schemaVersion", "id", "datasetId", "externalId", "input", "candidates", "metadata", "contentHash"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "datasetId": { "$ref": "#/$defs/id" }, "externalId": { "type": "string", "minLength": 1 }, "input": { "type": "string", "minLength": 1 }, "candidates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/candidate" } }, "metadata": { "type": "object" }, "contentHash": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "description", "rubricRef", "tags", "createdAt", "isDemo"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "rubricRef": { "$ref": "#/$defs/id" }, "tags": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "createdAt": { "$ref": "#/$defs/timestamp" }, "isDemo": { "type": "boolean" } },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["schemaVersion", "id", "datasetId", "rubricRef", "reviewerId", "blindMode", "seed", "state", "createdAt", "completedAt", "revealedAt"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "datasetId": { "$ref": "#/$defs/id" }, "rubricRef": { "$ref": "#/$defs/id" }, "reviewerId": { "$ref": "#/$defs/id" }, "blindMode": { "type": "boolean" }, "seed": { "type": "string", "minLength": 1 }, "state": { "enum": ["planned", "active", "completed", "revealed"] }, "createdAt": { "$ref": "#/$defs/timestamp" }, "completedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "revealedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] } },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["schemaVersion", "id", "sessionId", "caseId", "displayOrder", "state", "skipReason", "reviewId"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "sessionId": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "displayOrder": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "state": { "enum": ["pending", "in_progress", "complete", "skipped"] }, "skipReason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "reviewId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "repeatOf": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "calibration": { "type": "boolean" } },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["schemaVersion", "id", "assignmentId", "revision", "rubricSnapshot", "ratings", "computed", "preference", "confidence", "rationale", "issueLabels", "state", "createdAt", "updatedAt", "completedAt"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "assignmentId": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "supersedesReviewId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "rubricSnapshot": { "type": ["object", "null"] }, "ratings": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 5 }, { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 5 } }] } }, "computed": { "type": "object", "required": ["scoreByCandidate", "winner"] }, "preference": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 100 }, "confidenceScale": { "enum": ["anchored-1-5", "legacy-0-100"] }, "preferenceEvidence": { "type": "string" }, "rationale": { "type": "string" }, "issueLabels": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "state": { "enum": ["draft", "complete"] }, "createdAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "updatedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "completedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] } },
      "additionalProperties": false
    },
    "auditEvent": {
      "type": "object",
      "required": ["schemaVersion", "id", "entityType", "entityId", "action", "actorId", "at", "details"],
      "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "entityType": { "type": "string", "minLength": 1 }, "entityId": { "$ref": "#/$defs/id" }, "action": { "type": "string", "minLength": 1 }, "actorId": { "$ref": "#/$defs/id" }, "at": { "$ref": "#/$defs/timestamp" }, "details": { "type": "object" } },
      "additionalProperties": false
    }
  }
}
